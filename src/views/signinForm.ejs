<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign Up</title>
  <style>
    body {
      font-family: system-ui, sans-serif;
      max-width: 400px;
      margin: 60px auto;
      padding: 0 20px;
      color: #222;
    }

    h1 {
      font-size: 1.5rem;
      margin-bottom: 24px;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    label {
      font-weight: 600;
      margin-bottom: 4px;
      display: block;
    }

    input {
      width: 100%;
      padding: 8px 10px;
      border: 1px solid #ccc;
      border-radius: 6px;
      font-size: 1rem;
      box-sizing: border-box;
    }

    input.has-error {
      border-color: #d33;
    }

    .field-error {
      color: #d33;
      font-size: 0.85rem;
      margin-top: 4px;
    }

    .error-summary {
      background: #fdecea;
      border: 1px solid #f5c2c0;
      color: #a12a2a;
      padding: 12px 16px;
      border-radius: 6px;
      margin-bottom: 20px;
    }

    .error-summary ul {
      margin: 8px 0 0;
      padding-left: 20px;
    }

    button {
      background: #2563eb;
      color: white;
      border: none;
      padding: 10px 16px;
      border-radius: 6px;
      font-size: 1rem;
      cursor: pointer;
    }

    button:hover {
      background: #1d4ed8;
    }

    .footer-link {
      margin-top: 16px;
      font-size: 0.9rem;
      text-align: center;
    }
  </style>
</head>

<body>
  <h1>Create an account</h1>

  <% if (errors && errors.length> 0) { %>
    <div class="error-summary">
      <strong>Please fix the following:</strong>
      <ul>
        <% errors.forEach(function(err) { %>
          <li>
            <%= err.msg %>
          </li>
          <% }); %>
      </ul>
    </div>
    <% } %>

      <form action="/signin" method="POST" novalidate>
        <div>
          <label for="name">Name</label>
          <input type="text" id="name" name="name" value="<%= formData.name || '' %>"
            class="<%= errors.some(e => e.path === 'name') ? 'has-error' : '' %>" />
        </div>

        <div>
          <label for="email">Email</label>
          <input type="email" id="email" name="email" value="<%= formData.email || '' %>"
            class="<%= errors.some(e => e.path === 'email') ? 'has-error' : '' %>" />
        </div>

        <div>
          <label for="password">Password</label>
          <input type="password" id="password" name="password"
            class="<%= errors.some(e => e.path === 'password') ? 'has-error' : '' %>" />
        </div>

        <div>
          <label for="confirmPassword">Confirm Password</label>
          <input type="password" id="confirmPassword" name="confirmPassword"
            class="<%= errors.some(e => e.path === 'confirmPassword') ? 'has-error' : '' %>" />
        </div>

        <button type="submit">Sign Up</button>
      </form>

      <p class="footer-link">
        Already have an account? <a href="/login">Log in</a>
      </p>
</body>

</html>